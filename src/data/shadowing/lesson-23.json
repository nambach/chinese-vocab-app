{
  "id": "lesson-23",
  "title": "Bài 23",
  "audio": {
    "type": "file",
    "src": "audio/shadowing/bai-23.mp3"
  },
  "segments": [
    {
      "id": "s1",
      "text": "一、课文",
      "pinyin": "Yī, kèwén",
      "meaning": "Một. Bài khóa",
      "start": 0.18,
      "end": 1.75
    },
    {
      "id": "s2",
      "text": "一、学校里边有邮局吗",
      "pinyin": "Yī, xuéxiào lǐbian yǒu yóujú ma",
      "meaning": "Bài 1: Trong trường có bưu điện không?",
      "start": 3.23,
      "end": 7.65
    },
    {
      "id": "s3",
      "text": "学校里边儿有邮局吗？",
      "pinyin": "Xuéxiào lǐbianr yǒu yóujú ma?",
      "meaning": "Trong trường có bưu điện không?",
      "start": 9.45,
      "end": 11.93
    },
    {
      "id": "s4",
      "text": "有。",
      "pinyin": "Yǒu.",
      "meaning": "Có.",
      "start": 13.06,
      "end": 13.77
    },
    {
      "id": "s5",
      "text": "邮局在哪儿？",
      "pinyin": "Yóujú zài nǎr?",
      "meaning": "Bưu điện ở đâu?",
      "start": 15.02,
      "end": 16.62
    },
    {
      "id": "s6",
      "text": "在图书馆西边。",
      "pinyin": "Zài túshūguǎn xībian.",
      "meaning": "Ở phía tây thư viện.",
      "start": 17.65,
      "end": 19.63
    },
    {
      "id": "s7",
      "text": "离这儿远吗？",
      "pinyin": "Lí zhèr yuǎn ma?",
      "meaning": "Cách đây xa không?",
      "start": 20.66,
      "end": 22.07
    },
    {
      "id": "s8",
      "text": "不远。",
      "pinyin": "Bù yuǎn.",
      "meaning": "Không xa.",
      "start": 23.33,
      "end": 24.17
    },
    {
      "id": "s9",
      "text": "很近。",
      "pinyin": "Hěn jìn.",
      "meaning": "Rất gần.",
      "start": 24.68,
      "end": 25.51
    },
    {
      "id": "s10",
      "text": "图书馆东边是什么地方？",
      "pinyin": "Túshūguǎn dōngbian shì shénme dìfang?",
      "meaning": "Phía đông thư viện là chỗ nào?",
      "start": 26.66,
      "end": 29.68
    },
    {
      "id": "s11",
      "text": "图书馆东边是一个足球场。",
      "pinyin": "Túshūguǎn dōngbian shì yí ge zúqiúchǎng.",
      "meaning": "Phía đông thư viện là một sân bóng đá.",
      "start": 30.74,
      "end": 34.46
    },
    {
      "id": "s12",
      "text": "二、从这儿到博物馆有多远",
      "pinyin": "Èr, cóng zhèr dào bówùguǎn yǒu duō yuǎn",
      "meaning": "Bài 2: Từ đây đến bảo tàng xa bao nhiêu?",
      "start": 36.78,
      "end": 41.73
    },
    {
      "id": "s13",
      "text": "劳驾，我打听一下儿，博物馆在哪儿？",
      "pinyin": "Láojià, wǒ dǎting yíxiàr, bówùguǎn zài nǎr?",
      "meaning": "Làm phiền, tôi hỏi thăm một chút, bảo tàng ở đâu?",
      "start": 43.81,
      "end": 48.95
    },
    {
      "id": "s14",
      "text": "博物馆在东边，在和平公园和人民广场中间。",
      "pinyin": "Bówùguǎn zài dōngbian, zài Hépíng Gōngyuán hé Rénmín Guǎngchǎng zhōngjiān.",
      "meaning": "Bảo tàng ở phía đông, giữa Công viên Hòa Bình và Quảng trường Nhân dân.",
      "start": 50.13,
      "end": 57.51
    },
    {
      "id": "s15",
      "text": "离这儿有多远？",
      "pinyin": "Lí zhèr yǒu duō yuǎn?",
      "meaning": "Cách đây bao xa?",
      "start": 58.96,
      "end": 60.81
    },
    {
      "id": "s16",
      "text": "从这儿到那儿大概有七八百米。",
      "pinyin": "Cóng zhèr dào nàr dàgài yǒu qī bā bǎi mǐ.",
      "meaning": "Từ đây đến đó khoảng bảy tám trăm mét.",
      "start": 61.73,
      "end": 65.75
    },
    {
      "id": "s17",
      "text": "怎么走呢？",
      "pinyin": "Zěnme zǒu ne?",
      "meaning": "Đi thế nào?",
      "start": 66.91,
      "end": 68.16
    },
    {
      "id": "s18",
      "text": "你从这儿一直往东走，到红绿灯那儿往左拐，马路东边有一座白色的大楼，那就是博物馆。",
      "pinyin": "Nǐ cóng zhèr yìzhí wǎng dōng zǒu, dào hónglǜdēng nàr wǎng zuǒ guǎi, mǎlù dōngbian yǒu yí zuò báisè de dàlóu, nà jiùshì bówùguǎn.",
      "meaning": "Từ đây bạn đi thẳng về phía đông, đến đèn giao thông thì rẽ trái; phía đông đường có một tòa nhà trắng, đó chính là bảo tàng.",
      "start": 69.43,
      "end": 83.58
    },
    {
      "id": "s19",
      "text": "谢谢您！",
      "pinyin": "Xièxie nín!",
      "meaning": "Cảm ơn ông!",
      "start": 84.37,
      "end": 85.57
    },
    {
      "id": "s20",
      "text": "不客气。",
      "pinyin": "Bú kèqi.",
      "meaning": "Không có gì.",
      "start": 86.36,
      "end": 87.43
    },
