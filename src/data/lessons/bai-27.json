  "segments": [
    {
      "id": "s1",
      "text": "一、课文",
      "pinyin": "Yī, kèwén",
      "meaning": "Một. Bài khóa",
      "start": 0.18,
      "end": 1.92,
      "section": "heading"
    },
    {
      "id": "s2",
      "text": "一、你怎么了",
      "pinyin": "Yī, nǐ zěnme le",
      "meaning": "Bài 1: Bạn bị sao vậy",
      "start": 2.88,
      "end": 5.46,
      "section": "heading"
    },
    {
      "id": "s3",
      "text": "你怎么了？",
      "pinyin": "Nǐ zěnme le?",
      "meaning": "Bạn bị sao vậy?",
      "start": 6.67,
      "end": 7.85,
      "section": "kewen"
    },
    {
      "id": "s4",
      "text": "肚子疼得厉害，在家吃了两片药，还不行。",
      "pinyin": "Dùzi téng de lìhai, zài jiā chī le liǎng piàn yào, hái bù xíng.",
      "meaning": "Bụng đau dữ dội, ở nhà uống hai viên thuốc rồi vẫn chưa khỏi.",
      "start": 8.65,
      "end": 14.98,
      "section": "kewen"
    },
    {
      "id": "s5",
      "text": "拉肚子了吗？",
      "pinyin": "Lā dùzi le ma?",
      "meaning": "Bị tiêu chảy à?",
      "start": 15.74,
      "end": 17.14,
      "section": "kewen"
    },
    {
      "id": "s6",
      "text": "拉了。",
      "pinyin": "Lā le.",
      "meaning": "Có.",
      "start": 17.91,
      "end": 18.64,
      "section": "kewen"
    },
    {
      "id": "s7",
      "text": "昨天吃什么了？",
      "pinyin": "Zuótiān chī shénme le?",
      "meaning": "Hôm qua ăn gì?",
      "start": 19.23,
      "end": 21.11,
      "section": "kewen"
    },
    {
      "id": "s8",
      "text": "就吃了一些鱼和牛肉。",
      "pinyin": "Jiù chī le yìxiē yú hé niúròu.",
      "meaning": "Chỉ ăn một ít cá và thịt bò.",
      "start": 21.86,
      "end": 24.59,
      "section": "kewen"
    },
    {
      "id": "s9",
      "text": "喝什么了？",
      "pinyin": "Hē shénme le?",
      "meaning": "Uống gì?",
      "start": 25.31,
      "end": 26.52,
      "section": "kewen"
    },
    {
      "id": "s10",
      "text": "喝了一瓶啤酒。",
      "pinyin": "Hē le yì píng píjiǔ.",
      "meaning": "Uống một chai bia.",
      "start": 27.14,
      "end": 29.35,
      "section": "kewen"
    },
    {
      "id": "s11",
      "text": "发烧吗？",
      "pinyin": "Fā shāo ma?",
      "meaning": "Sốt không?",
      "start": 30.32,
      "end": 31.41,
      "section": "kewen"
    },
    {
      "id": "s12",
      "text": "不发烧。",
      "pinyin": "Bù fā shāo.",
      "meaning": "Không sốt.",
      "start": 32.17,
      "end": 33.25,
      "section": "kewen"
    },
    {
      "id": "s13",
      "text": "你先去化验一下大便，然后我再给你检查检查。",
      "pinyin": "Nǐ xiān qù huàyàn yíxià dàbiàn, ránhòu wǒ zài gěi nǐ jiǎnchá jiǎnchá.",
      "meaning": "Anh đi xét nghiệm phân trước, rồi tôi khám cho anh.",
      "start": 34.17,
      "end": 40.54,
      "section": "kewen"
    },
    {
      "id": "s14",
      "text": "好吧。",
      "pinyin": "Hǎo ba.",
      "meaning": "Vâng.",
      "start": 41.08,
      "end": 41.81,
      "section": "kewen"
    },
    {
      "id": "s15",
      "text": "化验结果出来了吗？",
      "pinyin": "Huàyàn jiéguǒ chūlái le ma?",
      "meaning": "Kết quả xét nghiệm đã ra chưa?",
      "start": 43.19,
      "end": 45.48,
      "section": "kewen"
    },
    {
      "id": "s16",
      "text": "出来了。",
      "pinyin": "Chūlái le.",
      "meaning": "Ra rồi.",
      "start": 46.06,
      "end": 46.93,
      "section": "kewen"
    },
    {
      "id": "s17",
      "text": "大夫，我是不是得了肠炎？",
      "pinyin": "Dàifu, wǒ shì bu shì dé le chángyán?",
      "meaning": "Bác sĩ, tôi có bị viêm ruột không?",
      "start": 47.74,
      "end": 51.62,
      "section": "kewen"
    },
    {
      "id": "s18",
      "text": "我看了化验的结果。不是肠炎，只是消化不好。",
      "pinyin": "Wǒ kàn le huàyàn de jiéguǒ. Bú shì chángyán, zhǐ shì xiāohuà bù hǎo.",
      "meaning": "Tôi xem kết quả xét nghiệm rồi, không phải viêm ruột, chỉ là tiêu hóa kém.",
      "start": 52.28,
      "end": 59.15,
      "section": "kewen"
    },
    {
      "id": "s19",
      "text": "先给你开一些药，再给你打一针。",
      "pinyin": "Xiān gěi nǐ kāi yìxiē yào, zài gěi nǐ dǎ yì zhēn.",
      "meaning": "Trước kê thuốc cho anh, rồi tiêm một mũi.",
      "start": 59.86,
      "end": 64.26,
      "section": "kewen"
    },
    {
      "id": "s20",
      "text": "这药怎么吃？",
      "pinyin": "Zhè yào zěnme chī?",
      "meaning": "Thuốc này uống thế nào?",
      "start": 65.07,
      "end": 66.81,
      "section": "kewen"
    },
    {
      "id": "s21",
      "text": "一天三次，一次两片，饭后吃。",
      "pinyin": "Yì tiān sān cì, yí cì liǎng piàn, fàn hòu chī.",
      "meaning": "Một ngày ba lần, mỗi lần hai viên, uống sau bữa ăn.",
      "start": 67.48,
      "end": 73.23,
      "section": "kewen"
    },
    {
      "id": "s22",
      "text": "二、玛丽哭了",
      "pinyin": "Èr, Mǎlì kū le",
      "meaning": "Bài 2: Mary khóc",
      "start": 75.08,
      "end": 77.83,
      "section": "heading"
    },
    {
      "id": "s23",
      "text": "玛丽，你怎么哭了？病了吗？",
      "pinyin": "Mǎlì, nǐ zěnme kū le? Bìng le ma?",
      "meaning": "Mary, sao bạn khóc? Bị ốm à?",
      "start": 79.21,
      "end": 83.44,
      "section": "kewen"
    },
    {
      "id": "s24",
      "text": "不是。",
      "pinyin": "Bú shì.",
      "meaning": "Không phải.",
      "start": 84.25,
      "end": 85.18,
      "section": "kewen"
    },
    {
      "id": "s25",
      "text": "想家了。",
      "pinyin": "Xiǎng jiā le.",
      "meaning": "Nhớ nhà rồi.",
      "start": 85.48,
      "end": 86.68,
      "section": "kewen"
    },
    {
      "id": "s26",
      "text": "因为感到寂寞，心情不好，所以很难过。",
      "pinyin": "Yīnwèi gǎndào jìmò, xīnqíng bù hǎo, suǒyǐ hěn nánguò.",
      "meaning": "Vì cảm thấy cô đơn, tâm trạng không tốt, nên rất buồn.",
      "start": 87.14,
      "end": 92.84,
      "section": "kewen"
    },
    {
      "id": "s27",
      "text": "别难过了。",
      "pinyin": "Bié nánguò le.",
      "meaning": "Đừng buồn nữa.",
      "start": 93.63,
      "end": 94.89,
      "section": "kewen"
    },
    {
      "id": "s28",
      "text": "你不想家吗？",
      "pinyin": "Nǐ bù xiǎng jiā ma?",
      "meaning": "Bạn không nhớ nhà à?",
      "start": 95.62,
      "end": 97.48,
      "section": "kewen"
    },
    {
      "id": "s29",
      "text": "我也常想家，但是不感到寂寞。",
      "pinyin": "Wǒ yě cháng xiǎng jiā, dànshì bù gǎndào jìmò.",
      "meaning": "Tôi cũng hay nhớ nhà, nhưng không cảm thấy cô đơn.",
      "start": 98.1,
      "end": 102.72,
      "section": "kewen"
    },
    {
      "id": "s30",
      "text": "我有姐姐，还有弟弟。在家时，我们常常一起玩儿，所以，感到寂寞时，总想他们。",
      "pinyin": "Wǒ yǒu jiějie, hái yǒu dìdi. Zài jiā shí, wǒmen chángcháng yìqǐ wánr, suǒyǐ, gǎndào jìmò shí, zǒng xiǎng tāmen.",
      "meaning": "Tôi có chị và em trai, ở nhà chúng tôi hay chơi cùng nhau, nên khi cô đơn lại nhớ đến họ.",
      "start": 103.77,
      "end": 116.61,
      "section": "kewen"
    },
    {
      "id": "s31",
      "text": "今天晚上礼堂有舞会，我们一起去跳跳舞吧。玩玩儿就好了。",
      "pinyin": "Jīntiān wǎnshang lǐtáng yǒu wǔhuì, wǒmen yìqǐ qù tiào tiào wǔ ba. Wán wánr jiù hǎo le.",
      "meaning": "Tối nay hội trường có vũ hội, chúng ta cùng đi nhảy, chơi chút là khá rồi.",
      "start": 117.72,
      "end": 127.49,
      "section": "kewen"
    },
    {
      "id": "s32",
      "text": "什么时候去？",
      "pinyin": "Shénme shíhou qù?",
      "meaning": "Khi nào đi?",
      "start": 128.29,
      "end": 129.74,
      "section": "kewen"
    },
    {
      "id": "s33",
      "text": "吃了晚饭就去吧。",
      "pinyin": "Chī le wǎnfàn jiù qù ba.",
      "meaning": "Ăn cơm tối xong rồi đi.",
      "start": 130.6,
      "end": 132.93,
      "section": "kewen"
    },
    {
      "id": "s34",
      "text": "你在宿舍等我，我来叫你。",
      "pinyin": "Nǐ zài sùshè děng wǒ, wǒ lái jiào nǐ.",
      "meaning": "Bạn đợi tôi ở ký túc, tôi đến gọi bạn.",
      "start": 133.73,
      "end": 137.91,
      "section": "kewen"
    },
    {
      "id": "s35",
      "text": "好吧。",
      "pinyin": "Hǎo ba.",
      "meaning": "Được.",
      "start": 138.97,
      "end": 139.69,
      "section": "kewen"
    },
    {
      "id": "s36",
      "text": "二、生词",
      "pinyin": "Èr, shēngcí",
      "meaning": "Hai. Từ mới",
      "start": 141.44,
      "end": 143.62,
      "section": "heading"
    },
