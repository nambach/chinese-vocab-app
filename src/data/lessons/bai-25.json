  "segments": [
    {
      "id": "s1",
      "text": "一、课文",
      "pinyin": "Yī, kèwén",
      "meaning": "Một. Bài khóa",
      "start": 0,
      "end": 1.66,
      "section": "heading"
    },
    {
      "id": "s2",
      "text": "一、她学得很好",
      "pinyin": "Yī, tā xué de hěn hǎo",
      "meaning": "Bài 1: Cô ấy học rất giỏi",
      "start": 2.72,
      "end": 6.04,
      "section": "heading"
    },
    {
      "id": "s3",
      "text": "罗兰，电视台想请留学生表演一个汉语节目，你愿意去吗？",
      "pinyin": "Luólán, diànshìtái xiǎng qǐng liúxuéshēng biǎoyǎn yí ge hànyǔ jiémù, nǐ yuànyì qù ma?",
      "meaning": "Roland, đài truyền hình muốn mời du học sinh biểu diễn một tiết mục tiếng Trung, bạn có muốn đi không?",
      "start": 6.04,
      "end": 16.38,
      "section": "kewen"
    },
    {
      "id": "s4",
      "text": "老师，我不想去。",
      "pinyin": "Lǎoshī, wǒ bù xiǎng qù.",
      "meaning": "Thưa thầy, em không muốn đi.",
      "start": 17.42,
      "end": 19.89,
      "section": "kewen"
    },
    {
      "id": "s5",
      "text": "为什么？",
      "pinyin": "Wèishénme?",
      "meaning": "Tại sao?",
      "start": 20.84,
      "end": 22.14,
      "section": "kewen"
    },
    {
      "id": "s6",
      "text": "我汉语说得不好，也不会表演。",
      "pinyin": "Wǒ hànyǔ shuō de bù hǎo, yě bú huì biǎoyǎn.",
      "meaning": "Tiếng Trung em nói không tốt, cũng không biết biểu diễn.",
      "start": 22.76,
      "end": 26.91,
      "section": "kewen"
    },
    {
      "id": "s7",
      "text": "你学得不错，有很大进步，汉语水平提高得很快。",
      "pinyin": "Nǐ xué de búcuò, yǒu hěn dà jìnbù, hànyǔ shuǐpíng tígāo de hěn kuài.",
      "meaning": "Bạn học không tồi, tiến bộ nhiều, trình độ tiếng Trung nâng lên rất nhanh.",
      "start": 27.98,
      "end": 35.03,
      "section": "kewen"
    },
    {
      "id": "s8",
      "text": "哪里，我发音发得不准，说得也不流利。",
      "pinyin": "Nǎli, wǒ fāyīn fā de bù zhǔn, shuō de yě bù liúlì.",
      "meaning": "Đâu có, em phát âm không chuẩn, nói cũng không lưu loát.",
      "start": 36.28,
      "end": 41.89,
      "section": "kewen"
    },
    {
      "id": "s9",
      "text": "让玛丽去吧。",
      "pinyin": "Ràng Mǎlì qù ba.",
      "meaning": "Để Mary đi vậy.",
      "start": 41.89,
      "end": 44.39,
      "section": "kewen"
    },
    {
      "id": "s10",
      "text": "她汉语学得很好，说得很流利。",
      "pinyin": "Tā hànyǔ xué de hěn hǎo, shuō de hěn liúlì.",
      "meaning": "Cô ấy học tiếng Trung rất tốt, nói rất lưu loát.",
      "start": 44.56,
      "end": 49.16,
      "section": "kewen"
    },
    {
      "id": "s11",
      "text": "玛丽还会唱京剧。",
      "pinyin": "Mǎlì hái huì chàng jīngjù.",
      "meaning": "Mary còn biết hát kinh kịch.",
      "start": 49.16,
      "end": 52.16,
      "section": "kewen"
    },
    {
      "id": "s12",
      "text": "是吗？",
      "pinyin": "Shì ma?",
      "meaning": "Vậy à?",
      "start": 53.04,
      "end": 53.56,
      "section": "kewen"
    },
    {
      "id": "s13",
      "text": "她京剧唱得怎么样？",
      "pinyin": "Tā jīngjù chàng de zěnmeyàng?",
      "meaning": "Kinh kịch cô ấy hát thế nào?",
      "start": 53.56,
      "end": 56.62,
      "section": "kewen"
    },
    {
      "id": "s14",
      "text": "王老师说她唱得不错。",
      "pinyin": "Wáng lǎoshī shuō tā chàng de búcuò.",
      "meaning": "Thầy Vương nói cô ấy hát không tồi.",
      "start": 57.66,
      "end": 60.02,
      "section": "kewen"
    },
    {
      "id": "s15",
      "text": "她怎么学得这么好？",
      "pinyin": "Tā zěnme xué de zhème hǎo?",
      "meaning": "Sao cô ấy học giỏi thế?",
      "start": 61,
      "end": 63.11,
      "section": "kewen"
    },
    {
      "id": "s16",
      "text": "她非常努力，也很认真。",
      "pinyin": "Tā fēicháng nǔlì, yě hěn rènzhēn.",
      "meaning": "Cô ấy rất cố gắng, cũng rất nghiêm túc.",
      "start": 63.9,
      "end": 67.29,
      "section": "kewen"
    },
    {
      "id": "s17",
      "text": "二、她每天都起得很早",
      "pinyin": "Èr, tā měi tiān dōu qǐ de hěn zǎo",
      "meaning": "Bài 2: Ngày nào cô ấy cũng dậy rất sớm",
      "start": 69.22,
      "end": 72.74,
      "section": "heading"
    },
    {
      "id": "s18",
      "text": "老师，您看她太极拳打得怎么样？",
      "pinyin": "Lǎoshī, nín kàn tā tàijíquán dǎ de zěnmeyàng?",
      "meaning": "Thưa thầy, thầy thấy cô ấy đánh thái cực quyền thế nào?",
      "start": 74.56,
      "end": 79.36,
      "section": "kewen"
    },
    {
      "id": "s19",
      "text": "打得不错。",
      "pinyin": "Dǎ de búcuò.",
      "meaning": "Đánh không tồi.",
      "start": 80.04,
      "end": 81.16,
      "section": "kewen"
    },
    {
      "id": "s20",
      "text": "为学太极拳，她每天都起得很早。",
      "pinyin": "Wèi xué tàijíquán, tā měi tiān dōu qǐ de hěn zǎo.",
      "meaning": "Để học thái cực quyền, ngày nào cô ấy cũng dậy rất sớm.",
      "start": 82.06,
      "end": 86.37,
      "section": "kewen"
    },
    {
      "id": "s21",
      "text": "麦克，你喜欢什么运动？",
      "pinyin": "Màikè, nǐ xǐhuan shénme yùndòng?",
      "meaning": "Mike, bạn thích môn thể thao nào?",
      "start": 87.56,
      "end": 90.47,
      "section": "kewen"
    },
    {
      "id": "s22",
      "text": "我喜欢跑步、打篮球。",
      "pinyin": "Wǒ xǐhuan pǎobù, dǎ lánqiú.",
      "meaning": "Tôi thích chạy bộ và đánh bóng rổ.",
      "start": 91.06,
      "end": 94.57,
      "section": "kewen"
    },
    {
      "id": "s23",
      "text": "刚才我看你跑得很快。",
      "pinyin": "Gāngcái wǒ kàn nǐ pǎo de hěn kuài.",
      "meaning": "Lúc nãy tôi thấy bạn chạy rất nhanh.",
      "start": 95.32,
      "end": 98.24,
      "section": "kewen"
    },
    {
      "id": "s24",
      "text": "你篮球打得怎么样？",
      "pinyin": "Nǐ lánqiú dǎ de zěnmeyàng?",
      "meaning": "Bóng rổ bạn đánh thế nào?",
      "start": 98.24,
      "end": 101.15,
      "section": "kewen"
    },
    {
      "id": "s25",
      "text": "打得还可以。",
      "pinyin": "Dǎ de hái kěyǐ.",
      "meaning": "Đánh cũng tạm được.",
      "start": 101.74,
      "end": 103.27,
      "section": "kewen"
    },
    {
      "id": "s26",
      "text": "老师，您每天都来锻炼吗？",
      "pinyin": "Lǎoshī, nín měi tiān dōu lái duànliàn ma?",
      "meaning": "Thưa thầy, ngày nào thầy cũng đến tập không?",
      "start": 104.56,
      "end": 108.28,
      "section": "kewen"
    },
    {
      "id": "s27",
      "text": "对，我每天都坚持锻炼。",
      "pinyin": "Duì, wǒ měi tiān dōu jiānchí duànliàn.",
      "meaning": "Đúng, ngày nào tôi cũng kiên trì tập.",
      "start": 108.96,
      "end": 112.58,
      "section": "kewen"
    },
    {
      "id": "s28",
      "text": "你呢？",
      "pinyin": "Nǐ ne?",
      "meaning": "Còn bạn?",
      "start": 112.58,
      "end": 113.97,
      "section": "kewen"
    },
    {
      "id": "s29",
      "text": "我不常锻炼，因为我晚上常常睡得很晚，早上起得也很晚。",
      "pinyin": "Wǒ bù cháng duànliàn, yīnwèi wǒ wǎnshang chángcháng shuì de hěn wǎn, zǎoshang qǐ de yě hěn wǎn.",
      "meaning": "Tôi không tập thường xuyên, vì tối hay ngủ rất muộn, sáng dậy cũng rất muộn.",
      "start": 114.68,
      "end": 124.12,
      "section": "kewen"
    },
    {
