  "segments": [
    {
      "id": "s1",
      "text": "一、课文",
      "pinyin": "Yī, kèwén",
      "meaning": "Một. Bài khóa",
      "start": 0,
      "end": 1.72,
      "section": "heading"
    },
    {
      "id": "s2",
      "text": "一、我想学太极拳",
      "pinyin": "Yī, wǒ xiǎng xué tàijíquán",
      "meaning": "Bài 1: Tôi muốn học thái cực quyền",
      "start": 3.05,
      "end": 6.95,
      "section": "heading"
    },
    {
      "id": "s3",
      "text": "你会打太极拳吗？",
      "pinyin": "Nǐ huì dǎ tàijíquán ma?",
      "meaning": "Bạn biết đánh thái cực quyền không?",
      "start": 6.95,
      "end": 10.95,
      "section": "kewen"
    },
    {
      "id": "s4",
      "text": "不会。",
      "pinyin": "Bú huì.",
      "meaning": "Không biết.",
      "start": 12.01,
      "end": 12.61,
      "section": "kewen"
    },
    {
      "id": "s5",
      "text": "你呢？",
      "pinyin": "Nǐ ne?",
      "meaning": "Còn bạn?",
      "start": 12.61,
      "end": 14.1,
      "section": "kewen"
    },
    {
      "id": "s6",
      "text": "我也不会。",
      "pinyin": "Wǒ yě bú huì.",
      "meaning": "Tôi cũng không biết.",
      "start": 15.35,
      "end": 16.63,
      "section": "kewen"
    },
    {
      "id": "s7",
      "text": "你想不想学？",
      "pinyin": "Nǐ xiǎng bu xiǎng xué?",
      "meaning": "Bạn có muốn học không?",
      "start": 16.63,
      "end": 19.15,
      "section": "kewen"
    },
    {
      "id": "s8",
      "text": "想学。",
      "pinyin": "Xiǎng xué.",
      "meaning": "Muốn học.",
      "start": 19.15,
      "end": 21.45,
      "section": "kewen"
    },
    {
      "id": "s9",
      "text": "我也想学。",
      "pinyin": "Wǒ yě xiǎng xué.",
      "meaning": "Tôi cũng muốn học.",
      "start": 22.31,
      "end": 24.15,
      "section": "kewen"
    },
    {
      "id": "s10",
      "text": "听说体育老师下星期教太极拳，我们去报名吧。",
      "pinyin": "Tīngshuō tǐyù lǎoshī xià xīngqī jiāo tàijíquán, wǒmen qù bàomíng ba.",
      "meaning": "Nghe nói thầy thể dục tuần sau dạy thái cực quyền, chúng ta đi ghi danh nhé.",
      "start": 24.15,
      "end": 32.18,
      "section": "kewen"
    },
    {
      "id": "s11",
      "text": "好。",
      "pinyin": "Hǎo.",
      "meaning": "Được.",
      "start": 32.9,
      "end": 33.79,
      "section": "kewen"
    },
    {
      "id": "s12",
      "text": "二、您能不能再说一遍",
      "pinyin": "Èr, nín néng bu néng zài shuō yí biàn",
      "meaning": "Bài 2: Thầy có thể nói lại một lần nữa không?",
      "start": 35.44,
      "end": 39.86,
      "section": "heading"
    },
    {
      "id": "s13",
      "text": "老师，我们想学太极拳，现在可以报名吗？",
      "pinyin": "Lǎoshī, wǒmen xiǎng xué tàijíquán, xiànzài kěyǐ bàomíng ma?",
      "meaning": "Thưa thầy, chúng em muốn học thái cực quyền, bây giờ ghi danh được không?",
      "start": 40.73,
      "end": 48.64,
      "section": "kewen"
    },
    {
      "id": "s14",
      "text": "可以。",
      "pinyin": "Kěyǐ.",
      "meaning": "Được.",
      "start": 49.52,
      "end": 50.11,
      "section": "kewen"
    },
    {
      "id": "s15",
      "text": "什么时候开始上课？",
      "pinyin": "Shénme shíhou kāishǐ shàngkè?",
      "meaning": "Khi nào bắt đầu lên lớp?",
      "start": 50.11,
      "end": 54.22,
      "section": "kewen"
    },
    {
      "id": "s16",
      "text": "下星期一。",
      "pinyin": "Xià xīngqīyī.",
      "meaning": "Thứ Hai tuần sau.",
      "start": 55.33,
      "end": 56.67,
      "section": "kewen"
    },
    {
      "id": "s17",
      "text": "每天下午都有课吗？",
      "pinyin": "Měi tiān xiàwǔ dōu yǒu kè ma?",
      "meaning": "Mỗi buổi chiều đều có lớp không?",
      "start": 56.67,
      "end": 60.08,
      "section": "kewen"
    },
    {
      "id": "s18",
      "text": "不，只一三五下午。",
      "pinyin": "Bù, zhǐ yī sān wǔ xiàwǔ.",
      "meaning": "Không, chỉ chiều thứ Hai, thứ Tư và thứ Sáu.",
      "start": 60.99,
      "end": 64.35,
      "section": "kewen"
    },
    {
      "id": "s19",
      "text": "对不起，您能不能再说一遍？",
      "pinyin": "Duìbuqǐ, nín néng bu néng zài shuō yí biàn?",
      "meaning": "Xin lỗi, thầy có thể nói lại một lần nữa không?",
      "start": 64.35,
      "end": 69.51,
      "section": "kewen"
    },
    {
      "id": "s20",
      "text": "我不懂“一三五”是什么意思。",
      "pinyin": "Wǒ bù dǒng yī sān wǔ shì shénme yìsi.",
      "meaning": "Em không hiểu “một ba năm” nghĩa là gì.",
      "start": 69.69,
      "end": 74.19,
      "section": "kewen"
    },
    {
      "id": "s21",
      "text": "就是星期一、星期三、星期五。",
      "pinyin": "Jiùshì xīngqīyī, xīngqīsān, xīngqīwǔ.",
      "meaning": "Là thứ Hai, thứ Tư và thứ Sáu.",
      "start": 74.93,
      "end": 79.89,
      "section": "kewen"
    },
    {
      "id": "s22",
      "text": "从几点到几点上课？",
      "pinyin": "Cóng jǐ diǎn dào jǐ diǎn shàngkè?",
      "meaning": "Học từ mấy giờ đến mấy giờ?",
      "start": 79.89,
      "end": 84.62,
      "section": "kewen"
    },
    {
      "id": "s23",
      "text": "四点半到五点半。",
      "pinyin": "Sì diǎn bàn dào wǔ diǎn bàn.",
      "meaning": "Từ bốn rưỡi đến năm rưỡi.",
      "start": 85.93,
      "end": 88.46,
      "section": "kewen"
    },
    {
      "id": "s24",
      "text": "一次一个小时。",
      "pinyin": "Yí cì yí ge xiǎoshí.",
      "meaning": "Mỗi buổi một tiếng.",
      "start": 88.46,
      "end": 91.48,
      "section": "kewen"
    },
    {
      "id": "s25",
      "text": "玛丽！",
      "pinyin": "Mǎlì!",
      "meaning": "Mary!",
      "start": 91.48,
      "end": 93.67,
      "section": "kewen"
    },
    {
      "id": "s26",
      "text": "玛丽怎么没来？",
      "pinyin": "Mǎlì zěnme méi lái?",
      "meaning": "Mary sao không đến?",
      "start": 93.67,
      "end": 96.17,
      "section": "kewen"
    },
    {
      "id": "s27",
      "text": "老师，玛丽让我给她请个假。",
      "pinyin": "Lǎoshī, Mǎlì ràng wǒ gěi tā qǐng ge jià.",
      "meaning": "Thưa thầy, Mary nhờ em xin phép nghỉ hộ cô ấy.",
      "start": 97.15,
      "end": 102.07,
      "section": "kewen"
    },
    {
      "id": "s28",
      "text": "她今天有点儿不舒服，头疼，发烧，咳嗽，可能感冒了。",
      "pinyin": "Tā jīntiān yǒudiǎnr bù shūfu, tóuténg, fāshāo, késou, kěnéng gǎnmào le.",
      "meaning": "Hôm nay cô ấy hơi không khỏe, nhức đầu, sốt, ho, có lẽ bị cảm rồi.",
      "start": 102.07,
      "end": 111.92,
      "section": "kewen"
    },
    {
      "id": "s29",
      "text": "她要去医院看病，不能来上课。",
      "pinyin": "Tā yào qù yīyuàn kànbìng, bù néng lái shàngkè.",
      "meaning": "Cô ấy phải đi bệnh viện khám, không đến lớp được.",
      "start": 111.92,
      "end": 117.09,
      "section": "kewen"
    },
