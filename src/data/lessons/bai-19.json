  "id": "bai-19",
  "title": "Bài 19",
  "textTitle": "Có thể thử một chút không?",
  "audio": {
    "type": "file",
    "src": "audio/shadowing/bai-19.mp3"
  },
  "segments": [
    {
      "id": "s1",
      "text": "一、课文",
      "pinyin": "Yī, kèwén",
      "meaning": "Một. Bài khóa",
      "start": 0,
      "end": 1.7,
      "section": "heading"
    },
    {
      "id": "s2",
      "text": "一、可以试试吗",
      "pinyin": "Yī, kěyǐ shìshi ma",
      "meaning": "Bài 1: Có thể thử một chút không?",
      "start": 1.7,
      "end": 5.87,
      "section": "heading"
    },
    {
      "id": "s3",
      "text": "我看看羽绒服。",
      "pinyin": "Wǒ kànkan yǔróngfú.",
      "meaning": "Mình xem áo lông vũ.",
      "start": 7.38,
      "end": 9.69,
      "section": "kewen"
    },
    {
      "id": "s4",
      "text": "你看看这件怎么样？",
      "pinyin": "Nǐ kànkan zhè jiàn zěnmeyàng?",
      "meaning": "Bạn xem cái này thế nào?",
      "start": 9.69,
      "end": 14.18,
      "section": "kewen"
    },
    {
      "id": "s5",
      "text": "又好又便宜。",
      "pinyin": "Yòu hǎo yòu piányi.",
      "meaning": "Vừa tốt vừa rẻ.",
      "start": 15.46,
      "end": 17.34,
      "section": "kewen"
    },
    {
      "id": "s6",
      "text": "这件有一点儿长。",
      "pinyin": "Zhè jiàn yǒu yìdiǎnr cháng.",
      "meaning": "Cái này dài hơn một chút.",
      "start": 17.34,
      "end": 20.7,
      "section": "kewen"
    },
    {
      "id": "s7",
      "text": "有短一点儿的吗？",
      "pinyin": "Yǒu duǎn yìdiǎnr de ma?",
      "meaning": "Có cái ngắn hơn một chút không?",
      "start": 20.7,
      "end": 23.13,
      "section": "kewen"
    },
    {
      "id": "s8",
      "text": "你要深颜色的还是要浅颜色的？",
      "pinyin": "Nǐ yào shēn yánsè de háishi yào qiǎn yánsè de?",
      "meaning": "Bạn muốn màu đậm hay màu nhạt?",
      "start": 24.38,
      "end": 29.83,
      "section": "kewen"
    },
    {
      "id": "s9",
      "text": "浅颜色的。",
      "pinyin": "Qiǎn yánsè de.",
      "meaning": "Màu nhạt.",
      "start": 30.72,
      "end": 32.2,
      "section": "kewen"
    },
    {
      "id": "s10",
      "text": "我试试可以吗？",
      "pinyin": "Wǒ shìshi kěyǐ ma?",
      "meaning": "Mình thử được không?",
      "start": 33.02,
      "end": 35.15,
      "section": "kewen"
    },
    {
      "id": "s11",
      "text": "当然可以。",
      "pinyin": "Dāngrán kěyǐ.",
      "meaning": "Đương nhiên là được.",
      "start": 36.18,
      "end": 37.21,
      "section": "kewen"
    },
    {
      "id": "s12",
      "text": "这件太肥了，有没有瘦一点儿的？",
      "pinyin": "Zhè jiàn tài féi le, yǒu méiyǒu shòu yìdiǎnr de?",
      "meaning": "Cái này rộng quá, có cái chật hơn một chút không?",
      "start": 38.5,
      "end": 43.42,
      "section": "kewen"
    },
    {
      "id": "s13",
      "text": "你再试试这一件。",
      "pinyin": "Nǐ zài shìshi zhè yí jiàn.",
      "meaning": "Bạn thử thêm cái này xem.",
      "start": 44.3,
      "end": 47.05,
      "section": "kewen"
    },
    {
      "id": "s14",
      "text": "这件不大不小，正合适。",
      "pinyin": "Zhè jiàn bú dà bù xiǎo, zhèng héshì.",
      "meaning": "Cái này không to không nhỏ, vừa khít.",
      "start": 47.62,
      "end": 51.86,
      "section": "kewen"
    },
    {
      "id": "s15",
      "text": "颜色也很好看。",
      "pinyin": "Yánsè yě hěn hǎokàn.",
      "meaning": "Màu cũng rất đẹp.",
      "start": 51.86,
      "end": 55.9,
      "section": "kewen"
    },
    {
      "id": "s16",
      "text": "二、便宜一点儿吧",
      "pinyin": "Èr, piányi yìdiǎnr ba",
      "meaning": "Bài 2: Rẻ hơn một chút nhé",
      "start": 57.23,
      "end": 60.69,
      "section": "heading"
    },
    {
      "id": "s17",
      "text": "这种羽绒服怎么卖？",
      "pinyin": "Zhè zhǒng yǔróngfú zěnme mài?",
      "meaning": "Áo lông vũ loại này giá bao nhiêu?",
      "start": 60.69,
      "end": 64.88,
      "section": "kewen"
    },
    {
      "id": "s18",
      "text": "一件四百块。",
      "pinyin": "Yí jiàn sìbǎi kuài.",
      "meaning": "Một cái bốn trăm tệ.",
      "start": 66.04,
      "end": 68.12,
      "section": "kewen"
    },
    {
      "id": "s19",
      "text": "太贵了。",
      "pinyin": "Tài guì le.",
      "meaning": "Đắt quá.",
      "start": 68.12,
      "end": 70.25,
      "section": "kewen"
    },
    {
      "id": "s20",
      "text": "便宜一点儿吧，二百怎么样？",
      "pinyin": "Piányi yìdiǎnr ba, èrbǎi zěnmeyàng?",
      "meaning": "Rẻ hơn một chút đi, hai trăm được không?",
      "start": 70.25,
      "end": 74.45,
      "section": "kewen"
    },
    {
      "id": "s21",
      "text": "二百太少了，不卖。",
      "pinyin": "Èrbǎi tài shǎo le, bú mài.",
      "meaning": "Hai trăm ít quá, không bán.",
      "start": 75.4,
      "end": 77.84,
      "section": "kewen"
    },
    {
      "id": "s22",
      "text": "可以打八折，你给三百二吧。",
      "pinyin": "Kěyǐ dǎ bā zhé, nǐ gěi sānbǎi èr ba.",
      "meaning": "Được giảm còn tám phần giá, bạn đưa ba trăm hai nhé.",
      "start": 77.84,
      "end": 83.16,
      "section": "kewen"
    },
    {
      "id": "s23",
      "text": "三百行不行？",
      "pinyin": "Sānbǎi xíng bu xíng?",
      "meaning": "Ba trăm được không?",
      "start": 84.08,
      "end": 85.55,
      "section": "kewen"
    },
    {
      "id": "s24",
      "text": "给你吧。",
      "pinyin": "Gěi nǐ ba.",
      "meaning": "Thôi bán cho bạn vậy.",
      "start": 86.96,
      "end": 87.93,
      "section": "kewen"
    },
    {
      "id": "s25",
      "text": "二、生词",
      "pinyin": "Èr, shēngcí",
      "meaning": "Hai. Từ mới",
      "start": 90.08,
      "end": 91.86,
      "section": "heading"
    },
    {
      "id": "s26",
      "text": "羽绒服",
      "pinyin": "yǔróngfú",
      "meaning": "áo lông vũ",
      "start": 91.86,
      "end": 94.76,
      "section": "shengci"
    },
    {
      "id": "s27",
      "text": "又……又……",
      "pinyin": "yòu……yòu……",
      "meaning": "vừa… vừa…",
