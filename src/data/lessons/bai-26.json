  "id": "bai-26",
  "title": "Bài 26",
  "textTitle": "Điền Phương đi đâu rồi",
  "audio": {
    "type": "file",
    "src": "audio/shadowing/bai-26.mp3"
  },
  "segments": [
    {
      "id": "s1",
      "text": "一、课文",
      "pinyin": "Yī, kèwén",
      "meaning": "Một. Bài khóa",
      "start": 0,
      "end": 1.9,
      "section": "heading"
    },
    {
      "id": "s2",
      "text": "一、田芳去哪儿了",
      "pinyin": "Yī, Tián Fāng qù nǎr le",
      "meaning": "Bài 1: Điền Phương đi đâu rồi",
      "start": 2.86,
      "end": 6.37,
      "section": "heading"
    },
    {
      "id": "s3",
      "text": "喂，是田芳吗？",
      "pinyin": "Wèi, shì Tián Fāng ma?",
      "meaning": "Alo, có phải Điền Phương không?",
      "start": 7.67,
      "end": 10.09,
      "section": "kewen"
    },
    {
      "id": "s4",
      "text": "田芳不在。是张东吧。",
      "pinyin": "Tián Fāng bú zài. Shì Zhāng Dōng ba.",
      "meaning": "Điền Phương không có. Là Trương Đông phải không.",
      "start": 10.79,
      "end": 14.6,
      "section": "kewen"
    },
    {
      "id": "s5",
      "text": "阿姨，您好。",
      "pinyin": "Āyí, nín hǎo.",
      "meaning": "Dì, chào dì.",
      "start": 15.6,
      "end": 17.49,
      "section": "kewen"
    },
    {
      "id": "s6",
      "text": "田芳去哪儿了？",
      "pinyin": "Tián Fāng qù nǎr le?",
      "meaning": "Điền Phương đi đâu rồi?",
      "start": 18.19,
      "end": 20.01,
      "section": "kewen"
    },
    {
      "id": "s7",
      "text": "她四点多就去同学家了。",
      "pinyin": "Tā sì diǎn duō jiù qù tóngxué jiā le.",
      "meaning": "Cô ấy hơn bốn giờ đã sang nhà bạn học rồi.",
      "start": 21.12,
      "end": 24.6,
      "section": "kewen"
    },
    {
      "id": "s8",
      "text": "她的一个中学同学要出国，",
      "pinyin": "Tā de yí ge zhōngxué tóngxué yào chū guó,",
      "meaning": "Một bạn trung học của cô ấy sắp ra nước ngoài,",
      "start": 25.7,
      "end": 29.56,
      "section": "kewen"
    },
    {
      "id": "s9",
      "text": "她去看看她。",
      "pinyin": "Tā qù kànkan tā.",
      "meaning": "Cô ấy đi thăm bạn ấy.",
      "start": 29.62,
      "end": 31.64,
      "section": "kewen"
    },
    {
      "id": "s10",
      "text": "她什么时候能回来？",
      "pinyin": "Tā shénme shíhou néng huílái?",
      "meaning": "Cô ấy lúc nào về được?",
      "start": 32.47,
      "end": 34.76,
      "section": "kewen"
    },
    {
      "id": "s11",
      "text": "她没说，你打她的手机吧。",
      "pinyin": "Tā méi shuō, nǐ dǎ tā de shǒujī ba.",
      "meaning": "Cô ấy không nói, anh gọi điện thoại cô ấy đi.",
      "start": 35.92,
      "end": 40.11,
      "section": "kewen"
    },
    {
      "id": "s12",
      "text": "我打了，",
      "pinyin": "Wǒ dǎ le,",
      "meaning": "Tôi gọi rồi,",
      "start": 40.82,
      "end": 42.08,
      "section": "kewen"
    },
    {
      "id": "s13",
      "text": "可是她关机了。",
      "pinyin": "Kěshì tā guānjī le.",
      "meaning": "Nhưng cô ấy tắt máy rồi.",
      "start": 42.72,
      "end": 44.53,
      "section": "kewen"
    },
    {
      "id": "s14",
      "text": "是吗？",
      "pinyin": "Shì ma?",
      "meaning": "Vậy à?",
      "start": 45.4,
      "end": 46.51,
      "section": "kewen"
    },
    {
      "id": "s15",
      "text": "你过一会儿再打吧。",
      "pinyin": "Nǐ guò yíhuìr zài dǎ ba.",
      "meaning": "Anh gọi lại lát nữa đi.",
      "start": 46.99,
      "end": 49.97,
      "section": "kewen"
    },
    {
      "id": "s16",
      "text": "阿姨，田芳回来了没有？",
      "pinyin": "Āyí, Tián Fāng huílái le méiyǒu?",
      "meaning": "Dì, Điền Phương về chưa?",
      "start": 51.4,
      "end": 55.21,
      "section": "kewen"
    },
    {
      "id": "s17",
      "text": "还没有呢。",
      "pinyin": "Hái méiyǒu ne.",
      "meaning": "Vẫn chưa.",
      "start": 55.82,
      "end": 57.52,
      "section": "kewen"
    },
    {
      "id": "s18",
      "text": "二、他又来电话了",
      "pinyin": "Èr, tā yòu lái diànhuà le",
      "meaning": "Bài 2: Anh ấy gọi điện thoại lại",
      "start": 58.93,
      "end": 62.77,
      "section": "heading"
    },
    {
      "id": "s19",
      "text": "妈，我回来了。",
      "pinyin": "Mā, wǒ huílái le.",
      "meaning": "Mẹ, con về rồi.",
      "start": 63.94,
      "end": 66.65,
      "section": "kewen"
    },
    {
      "id": "s20",
      "text": "张东给你打电话了没有？",
      "pinyin": "Zhāng Dōng gěi nǐ dǎ diànhuà le méiyǒu?",
      "meaning": "Trương Đông gọi cho con chưa?",
      "start": 67.58,
      "end": 70.64,
      "section": "kewen"
    },
    {
      "id": "s21",
      "text": "没有啊。",
      "pinyin": "Méiyǒu a.",
      "meaning": "Chưa.",
      "start": 71.15,
      "end": 72.47,
      "section": "kewen"
    },
    {
      "id": "s22",
      "text": "他来电话找你，说打你的手机，你关机了。",
      "pinyin": "Tā lái diànhuà zhǎo nǐ, shuō dǎ nǐ de shǒujī, nǐ guānjī le.",
      "meaning": "Anh ấy gọi tìm con, nói gọi điện thoại con mà con tắt máy.",
      "start": 73.29,
      "end": 80.08,
      "section": "kewen"
    },
    {
      "id": "s23",
      "text": "啊，对了，我忘开机了。",
      "pinyin": "À, duì le, wǒ wàng kāi jī le.",
      "meaning": "À, đúng rồi, con quên bật máy.",
      "start": 80.56,
      "end": 85.32,
      "section": "kewen"
    },
    {
      "id": "s24",
      "text": "快，电话又响了，你去接吧。",
      "pinyin": "Kuài, diànhuà yòu xiǎng le, nǐ qù jiē ba.",
      "meaning": "Mau, điện thoại reo lại rồi, con nghe đi.",
      "start": 85.87,
      "end": 90.93,
      "section": "kewen"
    },
    {
      "id": "s25",
      "text": "下午，你给我打电话了吧？",
      "pinyin": "Xiàwǔ, nǐ gěi wǒ dǎ diànhuà le ba?",
      "meaning": "Chiều nay anh gọi cho em phải không?",
      "start": 92.26,
      "end": 96.39,
      "section": "kewen"
    },
    {
      "id": "s26",
      "text": "打了，你怎么关机了？",
      "pinyin": "Dǎ le, nǐ zěnme guānjī le?",
      "meaning": "Gọi rồi, sao em tắt máy?",
      "start": 97.14,
      "end": 100.55,
      "section": "kewen"
    },
    {
      "id": "s27",
      "text": "对不起，我忘开机了。",
      "pinyin": "Duìbuqǐ, wǒ wàng kāi jī le.",
      "meaning": "Xin lỗi, em quên bật máy.",
      "start": 101.35,
      "end": 105.11,
      "section": "kewen"
    },
    {
      "id": "s28",
      "text": "下午，你做什么了？",
      "pinyin": "Xiàwǔ, nǐ zuò shénme le?",
      "meaning": "Chiều nay anh làm gì?",
      "start": 105.82,
      "end": 108.49,
      "section": "kewen"
    },
    {
      "id": "s29",
      "text": "我去踢足球了。",
      "pinyin": "Wǒ qù tī zúqiú le.",
      "meaning": "Anh đi đá bóng.",
      "start": 109.21,
      "end": 111.62,
      "section": "kewen"
    },
    {
      "id": "s30",
      "text": "今天，我们跟留学生代表队比赛了。",
      "pinyin": "Jīntiān, wǒmen gēn liúxuéshēng dàibiǎo duì bǐsài le.",
      "meaning": "Hôm nay đội mình đá với đội tuyển lưu học sinh.",
      "start": 112.27,
      "end": 117.4,
      "section": "kewen"
    },
    {
      "id": "s31",
      "text": "你们队又输了吧？",
      "pinyin": "Nǐmen duì yòu shū le ba?",
      "meaning": "Đội các anh lại thua rồi phải không?",
      "start": 118.61,
      "end": 121.17,
      "section": "kewen"
    },
    {
      "id": "s32",
      "text": "没有。",
      "pinyin": "Méiyǒu.",
      "meaning": "Không.",
      "start": 121.78,
      "end": 123,
      "section": "kewen"
    },
    {
      "id": "s33",
      "text": "这次我们赢了。",
      "pinyin": "Zhè cì wǒmen yíng le.",
      "meaning": "Lần này bọn em thắng.",
      "start": 123.88,
      "end": 126.3,
      "section": "kewen"
    },
    {
      "id": "s34",
      "text": "几比几？",
      "pinyin": "Jǐ bǐ jǐ?",
      "meaning": "Tỉ số mấy?",
      "start": 126.95,
      "end": 128.51,
      "section": "kewen"
    },
    {
      "id": "s35",
      "text": "二比一。",
      "pinyin": "Èr bǐ yī.",
      "meaning": "Hai một.",
      "start": 128.92,
      "end": 130.32,
      "section": "kewen"
    },
    {
      "id": "s36",
      "text": "祝贺你们！",
      "pinyin": "Zhùhè nǐmen!",
      "meaning": "Chúc mừng các anh!",
      "start": 130.55,
      "end": 132.06,
      "section": "kewen"
    },
    {
      "id": "s37",
      "text": "哎，你有什么事吗？",
      "pinyin": "Āi, nǐ yǒu shénme shì ma?",
      "meaning": "Này, anh có việc gì không?",
      "start": 132.77,
      "end": 135.87,
      "section": "kewen"
    },
    {
      "id": "s38",
      "text": "我想问问你，你不是要上托福班吗？报名了没有？",
      "pinyin": "Wǒ xiǎng wènwen nǐ, nǐ bú shì yào shàng Tuōfú bān ma? Bàomíng le méiyǒu?",
      "meaning": "Anh muốn hỏi em, anh không phải định học lớp TOEFL sao? Đăng ký chưa?",
      "start": 136.52,
      "end": 144.44,
      "section": "kewen"
    },
    {
      "id": "s39",
      "text": "已经报了。",
      "pinyin": "Yǐjīng bào le.",
      "meaning": "Đăng ký rồi.",
      "start": 144.86,
      "end": 146.43,
      "section": "kewen"
    },
    {
      "id": "s40",
      "text": "你是不是也想考托福？",
      "pinyin": "Nǐ shì bu shì yě xiǎng kǎo Tuōfú?",
      "meaning": "Anh cũng muốn thi TOEFL phải không?",
      "start": 146.79,
      "end": 150.39,
      "section": "kewen"
    },
    {
      "id": "s41",
      "text": "是。",
      "pinyin": "Shì.",
      "meaning": "Phải.",
      "start": 150.8,
      "end": 151.68,
      "section": "kewen"
    },
    {
      "id": "s42",
      "text": "我想明天去报名。",
      "pinyin": "Wǒ xiǎng míngtiān qù bàomíng.",
      "meaning": "Anh muốn mai đi đăng ký.",
      "start": 152.3,
      "end": 155.03,
      "section": "kewen"
    },
    {
      "id": "s43",
      "text": "你陪我一起去，好吗？",
      "pinyin": "Nǐ péi wǒ yìqǐ qù, hǎo ma?",
      "meaning": "Em đi cùng anh nhé?",
      "start": 155.35,
      "end": 158.81,
      "section": "kewen"
    },
    {
      "id": "s44",
      "text": "好的。",
      "pinyin": "Hǎo de.",
      "meaning": "Được.",
      "start": 159.05,
      "end": 160.09,
      "section": "kewen"
    },
    {
