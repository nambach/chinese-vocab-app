  "segments": [
    {
      "id": "s1",
      "text": "一、课文",
      "pinyin": "Yī, kèwén",
      "meaning": "Một. Bài khóa",
      "start": 0,
      "end": 1.78,
      "section": "heading"
    },
    {
      "id": "s2",
      "text": "一、你常去图书馆吗",
      "pinyin": "Yī, nǐ cháng qù túshūguǎn ma",
      "meaning": "Bài 1: Bạn có hay đến thư viện không",
      "start": 1.78,
      "end": 6.47,
      "section": "heading"
    },
    {
      "id": "s3",
      "text": "我现在去图书馆。",
      "pinyin": "Wǒ xiànzài qù túshūguǎn.",
      "meaning": "Bây giờ mình đi thư viện.",
      "start": 7.65,
      "end": 10.24,
      "section": "kewen"
    },
    {
      "id": "s4",
      "text": "你跟我一起去，好吗？",
      "pinyin": "Nǐ gēn wǒ yìqǐ qù, hǎo ma?",
      "meaning": "Bạn đi cùng mình nhé, được không?",
      "start": 10.24,
      "end": 14.21,
      "section": "kewen"
    },
    {
      "id": "s5",
      "text": "好，咱们走吧。",
      "pinyin": "Hǎo, zánmen zǒu ba.",
      "meaning": "Được, chúng ta đi thôi.",
      "start": 14.71,
      "end": 17.21,
      "section": "kewen"
    },
    {
      "id": "s6",
      "text": "你常去图书馆吗？",
      "pinyin": "Nǐ cháng qù túshūguǎn ma?",
      "meaning": "Bạn có hay đến thư viện không?",
      "start": 17.65,
      "end": 20.65,
      "section": "kewen"
    },
    {
      "id": "s7",
      "text": "常去。我常借书，也常在那儿看书。",
      "pinyin": "Cháng qù. Wǒ cháng jiè shū, yě cháng zài nàr kàn shū.",
      "meaning": "Hay đi chứ, mình thường mượn sách, cũng hay đọc sách ở đó.",
      "start": 21.41,
      "end": 26.87,
      "section": "kewen"
    },
    {
      "id": "s8",
      "text": "你呢？",
      "pinyin": "Nǐ ne?",
      "meaning": "Còn bạn?",
      "start": 27.23,
      "end": 28.22,
      "section": "kewen"
    },
    {
      "id": "s9",
      "text": "常去吗？",
      "pinyin": "Cháng qù ma?",
      "meaning": "Có hay đi không?",
      "start": 28.38,
      "end": 29.9,
      "section": "kewen"
    },
    {
      "id": "s10",
      "text": "我也常去。",
      "pinyin": "Wǒ yě cháng qù.",
      "meaning": "Mình cũng hay đi.",
      "start": 30.77,
      "end": 31.43,
      "section": "kewen"
    },
    {
      "id": "s11",
      "text": "有时候借书，有时候上网查资料，但不常在那儿看书。",
      "pinyin": "Yǒu shíhou jiè shū, yǒu shíhou shàngwǎng chá zīliào, dàn bù cháng zài nàr kàn shū.",
      "meaning": "Có lúc mượn sách, có lúc lên mạng tra tài liệu, nhưng không hay đọc sách ở đó.",
      "start": 31.43,
      "end": 41.15,
      "section": "kewen"
    },
    {
      "id": "s12",
      "text": "我总在宿舍看书。",
      "pinyin": "Wǒ zǒng zài sùshè kàn shū.",
      "meaning": "Mình luôn đọc sách ở ký túc xá.",
      "start": 41.15,
      "end": 44.86,
      "section": "kewen"
    },
    {
      "id": "s13",
      "text": "你的宿舍安静吗？",
      "pinyin": "Nǐ de sùshè ānjìng ma?",
      "meaning": "Ký túc xá của bạn có yên tĩnh không?",
      "start": 45.69,
      "end": 48.39,
      "section": "kewen"
    },
    {
      "id": "s14",
      "text": "很安静。",
      "pinyin": "Hěn ānjìng.",
      "meaning": "Rất yên tĩnh.",
      "start": 49.01,
      "end": 50.14,
      "section": "kewen"
    },
    {
      "id": "s15",
      "text": "二、晚上你常做什么",
      "pinyin": "Èr, wǎnshang nǐ cháng zuò shénme",
      "meaning": "Bài 2: Buổi tối bạn thường làm gì",
      "start": 51.81,
      "end": 55.21,
      "section": "heading"
    },
    {
      "id": "s16",
      "text": "晚上你常做什么？",
      "pinyin": "Wǎnshang nǐ cháng zuò shénme?",
      "meaning": "Buổi tối bạn thường làm gì?",
      "start": 56.59,
      "end": 58.44,
      "section": "kewen"
    },
    {
      "id": "s17",
      "text": "复习课文，预习生词，或者做练习。",
      "pinyin": "Fùxí kèwén, yùxí shēngcí, huòzhě zuò liànxí.",
      "meaning": "Ôn bài khóa, chuẩn bị trước từ mới, hoặc làm bài tập.",
      "start": 59.83,
      "end": 65.4,
      "section": "kewen"
    },
    {
      "id": "s18",
      "text": "有时候上网跟朋友聊天儿或者收发伊妹儿。",
      "pinyin": "Yǒu shíhou shàngwǎng gēn péngyou liáotiānr huòzhě shōufā yīmèir.",
      "meaning": "Có lúc lên mạng tán gẫu với bạn bè, hoặc gửi nhận e-mail.",
      "start": 66.23,
      "end": 73.02,
      "section": "kewen"
    },
    {
      "id": "s19",
      "text": "我也是，我还常看中文电影和电视剧的DVD。",
      "pinyin": "Wǒ yě shì, wǒ hái cháng kàn Zhōngwén diànyǐng hé diànshìjù de DVD.",
      "meaning": "Mình cũng vậy, mình còn hay xem DVD phim điện ảnh và phim truyền hình tiếng Trung.",
      "start": 73.02,
      "end": 80.82,
      "section": "kewen"
    },
    {
      "id": "s20",
      "text": "你常看吗？",
      "pinyin": "Nǐ cháng kàn ma?",
      "meaning": "Bạn có hay xem không?",
      "start": 81.14,
      "end": 82.85,
      "section": "kewen"
    },
    {
      "id": "s21",
      "text": "我很少看。",
      "pinyin": "Wǒ hěn shǎo kàn.",
      "meaning": "Mình rất ít khi xem.",
      "start": 83.15,
      "end": 84.58,
      "section": "kewen"
    },
    {
      "id": "s22",
      "text": "星期六和星期日你做什么？",
      "pinyin": "Xīngqīliù hé xīngqīrì nǐ zuò shénme?",
      "meaning": "Thứ Bảy và Chủ nhật bạn làm gì?",
      "start": 85.61,
      "end": 89.88,
      "section": "kewen"
    },
    {
      "id": "s23",
      "text": "有时候在宿舍休息，有时候跟朋友一起去公园玩儿，或者去超市买东西。",
      "pinyin": "Yǒu shíhou zài sùshè xiūxi, yǒu shíhou gēn péngyou yìqǐ qù gōngyuán wánr, huòzhě qù chāoshì mǎi dōngxi.",
      "meaning": "Có lúc mình nghỉ ngơi ở ký túc xá, có lúc cùng bạn bè đi công viên chơi, hoặc đi siêu thị mua đồ.",
      "start": 89.88,
      "end": 101.04,
      "section": "kewen"
    },
    {
      "id": "s24",
      "text": "二、生词",
      "pinyin": "Èr, shēngcí",
      "meaning": "Hai. Từ mới",
      "start": 103.28,
      "end": 104.85,
      "section": "heading"
    },
