  },
  "segments": [
    {
      "id": "s1",
      "text": "一、课文",
      "pinyin": "Yī, kèwén",
      "meaning": "Một. Bài khóa",
      "start": 0,
      "end": 1.95,
      "section": "heading"
    },
    {
      "id": "s2",
      "text": "一、你哪一年大学毕业",
      "pinyin": "Yī, nǐ nǎ yì nián dàxué bìyè",
      "meaning": "Bài 1: Bạn tốt nghiệp đại học năm nào?",
      "start": 3.06,
      "end": 7.44,
      "section": "heading"
    },
    {
      "id": "s3",
      "text": "你哪一年大学毕业？",
      "pinyin": "Nǐ nǎ yì nián dàxué bìyè?",
      "meaning": "Bạn tốt nghiệp đại học năm nào?",
      "start": 8.77,
      "end": 11.76,
      "section": "kewen"
    },
    {
      "id": "s4",
      "text": "明年。",
      "pinyin": "Míngnián.",
      "meaning": "Năm sau.",
      "start": 12.71,
      "end": 13.87,
      "section": "kewen"
    },
    {
      "id": "s5",
      "text": "你呢？",
      "pinyin": "Nǐ ne?",
      "meaning": "Còn bạn?",
      "start": 13.87,
      "end": 15.88,
      "section": "kewen"
    },
    {
      "id": "s6",
      "text": "我后年。",
      "pinyin": "Wǒ hòunián.",
      "meaning": "Mình thì năm sau nữa.",
      "start": 16.97,
      "end": 18.59,
      "section": "kewen"
    },
    {
      "id": "s7",
      "text": "你今年多大？",
      "pinyin": "Nǐ jīnnián duō dà?",
      "meaning": "Năm nay bạn bao nhiêu tuổi?",
      "start": 18.59,
      "end": 21.13,
      "section": "kewen"
    },
    {
      "id": "s8",
      "text": "我二十一岁。",
      "pinyin": "Wǒ èrshíyī suì.",
      "meaning": "Mình hai mươi mốt tuổi.",
      "start": 22.03,
      "end": 24.34,
      "section": "kewen"
    },
    {
      "id": "s9",
      "text": "属什么的？",
      "pinyin": "Shǔ shénme de?",
      "meaning": "Bạn tuổi con gì?",
      "start": 25.13,
      "end": 26.76,
      "section": "kewen"
    },
    {
      "id": "s10",
      "text": "属狗的。",
      "pinyin": "Shǔ gǒu de.",
      "meaning": "Tuổi Tuất.",
      "start": 27.93,
      "end": 29.33,
      "section": "kewen"
    },
    {
      "id": "s11",
      "text": "二、祝你生日快乐",
      "pinyin": "Èr, zhù nǐ shēngrì kuàilè",
      "meaning": "Bài 2: Chúc bạn sinh nhật vui vẻ",
      "start": 30.95,
      "end": 34.51,
      "section": "heading"
    },
    {
      "id": "s12",
      "text": "你的生日是几月几号？",
      "pinyin": "Nǐ de shēngrì shì jǐ yuè jǐ hào?",
      "meaning": "Sinh nhật của bạn là ngày mấy tháng mấy?",
      "start": 36.29,
      "end": 39.62,
      "section": "kewen"
    },
    {
      "id": "s13",
      "text": "我的生日是十月十八号，正好是星期六。",
      "pinyin": "Wǒ de shēngrì shì shíyuè shíbā hào, zhènghǎo shì xīngqīliù.",
      "meaning": "Sinh nhật mình là ngày 18 tháng 10, vừa đúng thứ Bảy.",
      "start": 40.65,
      "end": 47.98,
      "section": "kewen"
    },
    {
      "id": "s14",
      "text": "是吗？",
      "pinyin": "Shì ma?",
      "meaning": "Thế à?",
      "start": 49.33,
      "end": 50.37,
      "section": "kewen"
    },
    {
      "id": "s15",
      "text": "你打算怎么过？",
      "pinyin": "Nǐ dǎsuan zěnme guò?",
      "meaning": "Bạn định tổ chức thế nào?",
      "start": 50.37,
      "end": 53.13,
      "section": "kewen"
    },
    {
      "id": "s16",
      "text": "我准备举行一个生日晚会。",
      "pinyin": "Wǒ zhǔnbèi jǔxíng yí ge shēngrì wǎnhuì.",
      "meaning": "Mình định tổ chức một buổi tiệc sinh nhật.",
      "start": 53.77,
      "end": 58.52,
      "section": "kewen"
    },
    {
      "id": "s17",
      "text": "你也来参加，好吗？",
      "pinyin": "Nǐ yě lái cānjiā, hǎo ma?",
      "meaning": "Bạn cũng đến dự, được không?",
      "start": 58.52,
      "end": 62.34,
      "section": "kewen"
    },
    {
      "id": "s18",
      "text": "什么时间举行？",
      "pinyin": "Shénme shíjiān jǔxíng?",
      "meaning": "Tổ chức lúc nào?",
      "start": 62.99,
      "end": 65.21,
      "section": "kewen"
    },
    {
      "id": "s19",
      "text": "星期六晚上七点。",
      "pinyin": "Xīngqīliù wǎnshang qī diǎn.",
      "meaning": "Tối thứ Bảy lúc bảy giờ.",
      "start": 66.03,
      "end": 69.63,
      "section": "kewen"
    },
    {
      "id": "s20",
      "text": "在哪儿？",
      "pinyin": "Zài nǎr?",
      "meaning": "Ở đâu?",
      "start": 70.33,
      "end": 71.62,
      "section": "kewen"
    },
    {
      "id": "s21",
      "text": "就在我的房间。",
      "pinyin": "Jiù zài wǒ de fángjiān.",
      "meaning": "Ngay tại phòng mình.",
      "start": 72.17,
      "end": 74.41,
      "section": "kewen"
    },
    {
      "id": "s22",
      "text": "好。",
      "pinyin": "Hǎo.",
      "meaning": "Được.",
      "start": 75.36,
      "end": 76.35,
      "section": "kewen"
    },
    {
      "id": "s23",
      "text": "我一定去。",
      "pinyin": "Wǒ yídìng qù.",
      "meaning": "Mình nhất định sẽ đến.",
      "start": 76.35,
      "end": 78.13,
      "section": "kewen"
    },
    {
      "id": "s24",
      "text": "祝你生日快乐！",
      "pinyin": "Zhù nǐ shēngrì kuàilè!",
      "meaning": "Chúc bạn sinh nhật vui vẻ!",
      "start": 78.13,
      "end": 80.75,
      "section": "kewen"
    },
    {
      "id": "s25",
      "text": "谢谢！",
      "pinyin": "Xièxie!",
      "meaning": "Cảm ơn!",
      "start": 80.89,
      "end": 82.18,
      "section": "kewen"
    },
    {
      "id": "s26",
      "text": "二、生词",
