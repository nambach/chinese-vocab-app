  "segments": [
    {
      "id": "s1",
      "text": "一、课文",
      "pinyin": "Yī, kèwén",
      "meaning": "Một. Bài khóa",
      "start": 0,
      "end": 1.82,
      "section": "heading"
    },
    {
      "id": "s2",
      "text": "一、他在做什么呢",
      "pinyin": "Yī, tā zài zuò shénme ne",
      "meaning": "Bài 1: Anh ấy đang làm gì thế",
      "start": 1.82,
      "end": 6.23,
      "section": "heading"
    },
    {
      "id": "s3",
      "text": "麦克在宿舍吗？",
      "pinyin": "Màikè zài sùshè ma?",
      "meaning": "Mike có ở ký túc xá không?",
      "start": 7.76,
      "end": 9.98,
      "section": "kewen"
    },
    {
      "id": "s4",
      "text": "在。",
      "pinyin": "Zài.",
      "meaning": "Có.",
      "start": 11.08,
      "end": 11.48,
      "section": "kewen"
    },
    {
      "id": "s5",
      "text": "他在做什么呢？",
      "pinyin": "Tā zài zuò shénme ne?",
      "meaning": "Anh ấy đang làm gì thế?",
      "start": 11.48,
      "end": 13.9,
      "section": "kewen"
    },
    {
      "id": "s6",
      "text": "我出来的时候，他正在听音乐呢。",
      "pinyin": "Wǒ chūlái de shíhou, tā zhèngzài tīng yīnyuè ne.",
      "meaning": "Lúc mình đi ra, anh ấy đang nghe nhạc.",
      "start": 14.94,
      "end": 18.96,
      "section": "kewen"
    },
    {
      "id": "s7",
      "text": "你是不是在听音乐呢？",
      "pinyin": "Nǐ shì bu shì zài tīng yīnyuè ne?",
      "meaning": "Bạn đang nghe nhạc phải không?",
      "start": 20.04,
      "end": 22.89,
      "section": "kewen"
    },
    {
      "id": "s8",
      "text": "没有，我正听课文录音呢。",
      "pinyin": "Méiyǒu, wǒ zhèng tīng kèwén lùyīn ne.",
      "meaning": "Không, mình đang nghe băng bài khóa.",
      "start": 23.88,
      "end": 28.08,
      "section": "kewen"
    },
    {
      "id": "s9",
      "text": "下午你有事儿吗？",
      "pinyin": "Xiàwǔ nǐ yǒu shìr ma?",
      "meaning": "Chiều nay bạn có việc không?",
      "start": 28.78,
      "end": 30.59,
      "section": "kewen"
    },
    {
      "id": "s10",
      "text": "没有事儿。",
      "pinyin": "Méiyǒu shìr.",
      "meaning": "Không có việc.",
      "start": 31.58,
      "end": 32.57,
      "section": "kewen"
    },
    {
      "id": "s11",
      "text": "我们一起去书店，好吗？",
      "pinyin": "Wǒmen yìqǐ qù shūdiàn, hǎo ma?",
      "meaning": "Chúng ta cùng đi hiệu sách nhé?",
      "start": 33.4,
      "end": 36.25,
      "section": "kewen"
    },
    {
      "id": "s12",
      "text": "你要买什么书？",
      "pinyin": "Nǐ yào mǎi shénme shū?",
      "meaning": "Bạn muốn mua sách gì?",
      "start": 37.02,
      "end": 39.29,
      "section": "kewen"
    },
    {
      "id": "s13",
      "text": "我想买一本《汉英词典》。",
      "pinyin": "Wǒ xiǎng mǎi yì běn Hàn-Yīng cídiǎn.",
      "meaning": "Mình muốn mua một cuốn từ điển Hán-Anh.",
      "start": 39.88,
      "end": 43.05,
      "section": "kewen"
    },
    {
      "id": "s14",
      "text": "咱们怎么去呢？",
      "pinyin": "Zánmen zěnme qù ne?",
      "meaning": "Chúng ta đi bằng gì?",
      "start": 43.96,
      "end": 45.91,
      "section": "kewen"
    },
    {
      "id": "s15",
      "text": "坐车去吧。",
      "pinyin": "Zuò chē qù ba.",
      "meaning": "Đi xe thôi.",
      "start": 46.94,
      "end": 48.26,
      "section": "kewen"
    },
    {
      "id": "s16",
      "text": "今天星期六，坐车太挤，骑车去怎么样？",
      "pinyin": "Jīntiān xīngqīliù, zuò chē tài jǐ, qí chē qù zěnmeyàng?",
      "meaning": "Hôm nay thứ Bảy, đi xe đông quá, đi xe đạp thì sao?",
      "start": 49.4,
      "end": 55.78,
      "section": "kewen"
    },
    {
      "id": "s17",
      "text": "行。",
      "pinyin": "Xíng.",
      "meaning": "Được.",
      "start": 56.46,
      "end": 57.22,
      "section": "kewen"
    },
    {
      "id": "s18",
      "text": "二、谁教你们语法",
      "pinyin": "Èr, shuí jiāo nǐmen yǔfǎ",
      "meaning": "Bài 2: Ai dạy các bạn ngữ pháp",
      "start": 59.14,
      "end": 62.72,
      "section": "heading"
    },
    {
      "id": "s19",
      "text": "玛丽，你们有几门课？",
      "pinyin": "Mǎlì, nǐmen yǒu jǐ mén kè?",
      "meaning": "Mary, các bạn có mấy môn?",
      "start": 64.54,
      "end": 68.73,
      "section": "kewen"
    },
    {
      "id": "s20",
      "text": "现在只有四门课：综合课、口语课、听力课和阅读课。",
      "pinyin": "Xiànzài zhǐ yǒu sì mén kè: zōnghé kè, kǒuyǔ kè, tīnglì kè hé yuèdú kè.",
      "meaning": "Bây giờ chỉ có bốn môn: tổng hợp, khẩu ngữ, nghe và đọc.",
      "start": 69.64,
      "end": 79.07,
      "section": "kewen"
    },
    {
      "id": "s21",
      "text": "有文化课和体育课吗？",
      "pinyin": "Yǒu wénhuà kè hé tǐyù kè ma?",
      "meaning": "Có môn văn hóa và thể dục không?",
      "start": 79.4,
      "end": 85.1,
      "section": "kewen"
    },
    {
      "id": "s22",
      "text": "没有。",
      "pinyin": "Méiyǒu.",
      "meaning": "Không có.",
      "start": 85.96,
      "end": 86.56,
      "section": "kewen"
    },
    {
      "id": "s23",
      "text": "林老师教你们什么？",
      "pinyin": "Lín lǎoshī jiāo nǐmen shénme?",
      "meaning": "Cô Lâm dạy các bạn môn gì?",
      "start": 86.56,
      "end": 91.33,
      "section": "kewen"
    },
    {
      "id": "s24",
      "text": "她教我们听力和阅读？",
      "pinyin": "Tā jiāo wǒmen tīnglì hé yuèdú?",
      "meaning": "Cô ấy dạy chúng mình nghe và đọc?",
      "start": 92.54,
      "end": 95.27,
      "section": "kewen"
    },
    {
      "id": "s25",
      "text": "谁教你们综合课和口语课？",
      "pinyin": "Shuí jiāo nǐmen zōnghé kè hé kǒuyǔ kè?",
      "meaning": "Ai dạy các bạn tổng hợp và khẩu ngữ?",
      "start": 95.27,
      "end": 102.27,
      "section": "kewen"
    },
    {
      "id": "s26",
      "text": "王老师。",
      "pinyin": "Wáng lǎoshī.",
      "meaning": "Thầy Vương.",
      "start": 102.86,
      "end": 104.66,
      "section": "kewen"
    },
    {
