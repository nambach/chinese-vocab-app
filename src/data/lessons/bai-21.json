  "segments": [
    {
      "id": "s1",
      "text": "一、课文",
      "pinyin": "Yī, kèwén",
      "meaning": "Một. Bài khóa",
      "start": 0,
      "end": 2.13,
      "section": "heading"
    },
    {
      "id": "s2",
      "text": "一、我的一天",
      "pinyin": "Yī, wǒ de yì tiān",
      "meaning": "Bài 1: Một ngày của tôi",
      "start": 3.36,
      "end": 6.09,
      "section": "heading"
    },
    {
      "id": "s3",
      "text": "我每天早上六点半起床，七点吃早饭。",
      "pinyin": "Wǒ měitiān zǎoshang liù diǎn bàn qǐchuáng, qī diǎn chī zǎofàn.",
      "meaning": "Mỗi sáng tôi thức dậy lúc sáu giờ rưỡi, bảy giờ ăn sáng.",
      "start": 6.09,
      "end": 13.53,
      "section": "kewen"
    },
    {
      "id": "s4",
      "text": "差十分八点去教室，八点上课。",
      "pinyin": "Chà shí fēn bā diǎn qù jiàoshì, bā diǎn shàngkè.",
      "meaning": "Bảy giờ năm mươi đến phòng học, tám giờ lên lớp.",
      "start": 13.63,
      "end": 19.41,
      "section": "kewen"
    },
    {
      "id": "s5",
      "text": "上午我们有四节课，十二点下课。",
      "pinyin": "Shàngwǔ wǒmen yǒu sì jié kè, shí'èr diǎn xiàkè.",
      "meaning": "Buổi sáng chúng tôi có bốn tiết, mười hai giờ tan học.",
      "start": 19.93,
      "end": 25.93,
      "section": "kewen"
    },
    {
      "id": "s6",
      "text": "中午我去食堂吃午饭。",
      "pinyin": "Zhōngwǔ wǒ qù shítáng chī wǔfàn.",
      "meaning": "Buổi trưa tôi ra căng tin ăn trưa.",
      "start": 26.85,
      "end": 30.34,
      "section": "kewen"
    },
    {
      "id": "s7",
      "text": "午饭以后，我常常去朋友那儿聊天儿。",
      "pinyin": "Wǔfàn yǐhòu, wǒ chángcháng qù péngyou nàr liáotiānr.",
      "meaning": "Sau bữa trưa, tôi thường đến chỗ bạn tán gẫu.",
      "start": 31.17,
      "end": 35.97,
      "section": "kewen"
    },
    {
      "id": "s8",
      "text": "下午没有课的时候，我去图书馆看书，或者跟中国朋友一起练习口语。",
      "pinyin": "Xiàwǔ méiyǒu kè de shíhou, wǒ qù túshūguǎn kàn shū, huòzhě gēn Zhōngguó péngyou yìqǐ liànxí kǒuyǔ.",
      "meaning": "Buổi chiều không có tiết thì tôi đến thư viện đọc sách, hoặc luyện nói với bạn Trung Quốc.",
      "start": 36.53,
      "end": 47.68,
      "section": "kewen"
    },
    {
      "id": "s9",
      "text": "有时候在宿舍看电影光盘。",
      "pinyin": "Yǒu shíhou zài sùshè kàn diànyǐng guāngpán.",
      "meaning": "Có lúc ở ký túc xá xem đĩa phim.",
      "start": 48.25,
      "end": 52.67,
      "section": "kewen"
    },
    {
      "id": "s10",
      "text": "四点我去操场锻炼身体。",
      "pinyin": "Sì diǎn wǒ qù cāochǎng duànliàn shēntǐ.",
      "meaning": "Bốn giờ tôi ra sân tập thể dục.",
      "start": 53.57,
      "end": 57.99,
      "section": "kewen"
    },
    {
      "id": "s11",
      "text": "五点回宿舍洗澡、洗衣服。",
      "pinyin": "Wǔ diǎn huí sùshè xǐzǎo, xǐ yīfu.",
      "meaning": "Năm giờ về ký túc xá tắm, giặt quần áo.",
      "start": 58.43,
      "end": 63.23,
      "section": "kewen"
    },
    {
      "id": "s12",
      "text": "六点半或者七点吃晚饭。",
      "pinyin": "Liù diǎn bàn huòzhě qī diǎn chī wǎnfàn.",
      "meaning": "Sáu giờ rưỡi hoặc bảy giờ ăn tối.",
      "start": 63.89,
      "end": 67.42,
      "section": "kewen"
    },
    {
      "id": "s13",
      "text": "晚上我做练习、写汉字、预习课文和生词，然后看看电视、听听音乐，十一点睡觉。",
      "pinyin": "Wǎnshang wǒ zuò liànxí, xiě hànzì, yùxí kèwén hé shēngcí, ránhòu kànkan diànshì, tīngting yīnyuè, shíyī diǎn shuìjiào.",
      "meaning": "Buổi tối tôi làm bài tập, viết chữ Hán, chuẩn bị bài khóa và từ mới, rồi xem tivi, nghe nhạc, mười một giờ đi ngủ.",
      "start": 68.71,
      "end": 82.4,
      "section": "kewen"
    },
    {
      "id": "s14",
      "text": "二、明天早上七点一刻出发",
      "pinyin": "Èr, míngtiān zǎoshang qī diǎn yí kè chūfā",
      "meaning": "Bài 2: Sáng mai bảy giờ mười lăm xuất phát",
      "start": 84.06,
      "end": 89.39,
      "section": "heading"
    },
    {
      "id": "s15",
      "text": "同学们，明天我们去爬山。",
      "pinyin": "Tóngxuémen, míngtiān wǒmen qù pá shān.",
      "meaning": "Các bạn, ngày mai chúng ta đi leo núi.",
      "start": 90.03,
      "end": 94.25,
      "section": "kewen"
    },
    {
      "id": "s16",
      "text": "太好了！",
      "pinyin": "Tài hǎo le!",
      "meaning": "Tuyệt quá!",
      "start": 94.55,
      "end": 96.01,
      "section": "kewen"
    },
    {
      "id": "s17",
      "text": "老师，您去吗？",
      "pinyin": "Lǎoshī, nín qù ma?",
      "meaning": "Thầy ơi, thầy có đi không?",
      "start": 96.01,
      "end": 99.2,
      "section": "kewen"
    },
    {
      "id": "s18",
      "text": "去。",
      "pinyin": "Qù.",
      "meaning": "Có.",
      "start": 99.53,
      "end": 100,
      "section": "kewen"
    },
    {
      "id": "s19",
      "text": "一年级的老师和学生都去。",
      "pinyin": "Yì niánjí de lǎoshī hé xuésheng dōu qù.",
      "meaning": "Giáo viên và sinh viên năm thứ nhất đều đi.",
      "start": 100,
      "end": 104.9,
      "section": "kewen"
    },
    {
      "id": "s20",
      "text": "明天什么时候出发？",
      "pinyin": "Míngtiān shénme shíhou chūfā?",
      "meaning": "Ngày mai lúc nào xuất phát?",
      "start": 105.81,
      "end": 108.64,
      "section": "kewen"
    },
    {
      "id": "s21",
      "text": "明天早上七点在楼前集合上车，七点一刻准时出发。",
      "pinyin": "Míngtiān zǎoshang qī diǎn zài lóu qián jíhé shàngchē, qī diǎn yí kè zhǔnshí chūfā.",
      "meaning": "Sáng mai bảy giờ tập trung lên xe trước tòa nhà, bảy giờ mười lăm xuất phát đúng giờ.",
      "start": 109.85,
      "end": 119.16,
      "section": "kewen"
    },
    {
      "id": "s22",
      "text": "中午回来吗？",
      "pinyin": "Zhōngwǔ huílái ma?",
      "meaning": "Trưa về không?",
      "start": 119.89,
      "end": 121.49,
      "section": "kewen"
    },
    {
      "id": "s23",
      "text": "不回来。",
      "pinyin": "Bù huílái.",
      "meaning": "Không về.",
      "start": 122.17,
      "end": 122.65,
      "section": "kewen"
    },
    {
      "id": "s24",
      "text": "要带午饭。",
      "pinyin": "Yào dài wǔfàn.",
      "meaning": "Phải mang cơm trưa theo.",
      "start": 122.65,
      "end": 125.61,
      "section": "kewen"
    },
    {
      "id": "s25",
      "text": "什么时候回来？",
      "pinyin": "Shénme shíhou huílái?",
      "meaning": "Lúc nào thì về?",
      "start": 126.47,
      "end": 128.18,
      "section": "kewen"
    },
    {
      "id": "s26",
      "text": "下午四点。",
      "pinyin": "Xiàwǔ sì diǎn.",
      "meaning": "Bốn giờ chiều.",
      "start": 128.59,
      "end": 130.68,
      "section": "kewen"
    },
